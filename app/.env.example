# M4 backend config (copy to .env.local and fill in)

# Postgres connection (Prisma). Local dev example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/irembo?schema=public"

# Data backend selector: "json" (default, in-memory from dataset.json) | "prisma"
DATA_BACKEND="json"

# Auth: HMAC secret for the signed session cookie. SET THIS IN PRODUCTION.
# (Sign-in is a dev role-picker today; RISA SSO replaces the /api/auth/login issuer.)
AUTH_SECRET="change-me-to-a-long-random-string"
